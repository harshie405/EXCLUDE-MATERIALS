*------------------------------------------------------------------------------*
CLASS lhc_zcomv_i_excl_mtrl DEFINITION INHERITING FROM cl_abap_behavior_handler.


  PRIVATE SECTION.

    METHODS get_instance_authorizations FOR INSTANCE AUTHORIZATION
      IMPORTING keys REQUEST requested_authorizations FOR zcomv_i_excl_mtrl RESULT result.

ENDCLASS.

CLASS lhc_zcomv_i_excl_mtrl IMPLEMENTATION.
  METHOD get_instance_authorizations.

    DATA: lv_upd       TYPE abap_bool VALUE abap_false,
          lt_update_t  TYPE TABLE FOR UPDATE zcomv_i_excl_mtrl,
          lt_update_t1 TYPE TABLE FOR UPDATE zcomv_i_excl_mtrl,
          lv_del       TYPE abap_bool VALUE abap_false.
    CONSTANTS: lc_actvt    TYPE fieldname      VALUE 'ACTVT',
               lc_02       TYPE activ_auth     VALUE '02',
               lc_ddlname  TYPE fieldname      VALUE 'TABLE',
               lc_ret_dlft TYPE fieldname      VALUE 'ZCOMV_EXCL_MTRL'.
*- Reading the Entries of the entity
    READ ENTITIES OF zcomv_i_excl_mtrl  IN LOCAL MODE
    ENTITY zcomv_i_excl_mtrl
    ALL FIELDS WITH CORRESPONDING #( keys )

    RESULT DATA(lt_mtrl)
    FAILED DATA(lt_failed).

*- Checking if the internal table is not initial
    IF lt_mtrl[] IS NOT INITIAL.

*- Checking the authorization Object
      AUTHORITY-CHECK OBJECT 'S_TABU_NAM'
         ID lc_actvt  FIELD   lc_02
         ID lc_ddlname  FIELD lc_ret_dlft.
      IF sy-subrc <> 0.
        lv_upd = abap_true.
        lv_del = abap_true.
      ENDIF.

      LOOP AT lt_mtrl ASSIGNING FIELD-SYMBOL(<fs_dfltdet>).

        APPEND VALUE #( LET upd_auth = COND #( WHEN lv_upd = abap_true THEN if_abap_behv=>auth-unauthorized
                                                     ELSE if_abap_behv=>auth-allowed )
                            del_auth = COND #( WHEN lv_del = abap_true THEN if_abap_behv=>auth-unauthorized
                                                     ELSE if_abap_behv=>auth-allowed )
                              IN
                               %tky            = <fs_dfltdet>-%tky
                               %update         = upd_auth
                               %delete         = del_auth
                            ) TO result.

      ENDLOOP.

    ENDIF.

  ENDMETHOD.

ENDCLASS.

